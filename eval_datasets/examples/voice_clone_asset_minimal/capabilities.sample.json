{
  "schema_version": "heuristic_eval.capability_registry.v0",
  "registry_id": "voice_clone_asset_minimal_capabilities",
  "scope": "example_project",
  "description": "Synthetic example showing how a voice clone project can expose evaluator capabilities to an agent without revealing private model paths or audio assets.",
  "project_context": {
    "profile": "voice_clone_asset",
    "character_id": "sample_character"
  },
  "privacy_policy": {
    "commit_policy": "synthetic_example_only",
    "local_registry_recommendation": ".heuristic-eval.local/capabilities.json",
    "do_not_commit": [
      "real model paths",
      "real audio paths",
      "speaker identities",
      "provider keys",
      "signed URLs"
    ]
  },
  "agent_usage": {
    "selection_rule": "Choose the cheapest capability that can answer the current routing question. Escalate to optional audio judges only for ambiguous or high-impact cases.",
    "evidence_rule": "Write capability outputs as observations and keep human review for speaker identity, role style, and final route confirmation.",
    "default_voice_clone_order": [
      "local.audio_qc.vad",
      "local.audio_quality.no_reference",
      "local.audio_judge.speech_attributes",
      "local.audio_judge.naturalness_preference",
      "local.human_review.voice_clone_spot_check"
    ]
  },
  "capabilities": [
    {
      "id": "local.audio_qc.vad",
      "kind": "audio_qc",
      "mode": "pointwise",
      "status": "available",
      "cost_tier": "low",
      "privacy": "local_only",
      "signals": [
        "pause_ratio",
        "speech_segments"
      ],
      "inputs": {
        "required": [
          "audio_uri"
        ]
      },
      "runner": {
        "kind": "local_command",
        "command_template": [
          "python3",
          "${HEURISTIC_EVAL_AUDIO_RUNNERS}/vad_runner.py",
          "--input",
          "${INPUT_JSON}",
          "--output",
          "${OUTPUT_JSONL}"
        ]
      },
      "blocked_uses": [
        "speaker_identity_decision",
        "character_style_decision"
      ]
    },
    {
      "id": "local.audio_quality.no_reference",
      "kind": "audio_quality",
      "mode": "pointwise",
      "status": "available",
      "cost_tier": "low",
      "privacy": "local_only",
      "signals": [
        "quality_proxy",
        "distortion_proxy"
      ],
      "inputs": {
        "required": [
          "audio_uri"
        ]
      },
      "runner": {
        "kind": "local_command",
        "command_template": [
          "python3",
          "${HEURISTIC_EVAL_AUDIO_RUNNERS}/no_reference_quality_runner.py",
          "--input",
          "${INPUT_JSON}",
          "--output",
          "${OUTPUT_JSONL}"
        ]
      },
      "blocked_uses": [
        "final_voice_quality_claim"
      ]
    },
    {
      "id": "local.audio_judge.speech_attributes",
      "kind": "audio_judge",
      "mode": "pointwise",
      "status": "optional",
      "cost_tier": "high",
      "privacy": "local_only",
      "signals": [
        "speech_rate_label",
        "speech_clarity_label",
        "speaking_style_label"
      ],
      "inputs": {
        "required": [
          "audio_uri"
        ],
        "optional": [
          "text",
          "rubric_prompt"
        ]
      },
      "runner": {
        "kind": "local_command",
        "command_template": [
          "python3",
          "${HEURISTIC_EVAL_AUDIO_RUNNERS}/audio_llm_attributes_runner.py",
          "--input",
          "${INPUT_JSON}",
          "--output",
          "${OUTPUT_JSONL}"
        ],
        "model_ref_env": "HEURISTIC_EVAL_AUDIO_LLM_MODEL"
      },
      "blocked_uses": [
        "automatic_gate_promotion",
        "source_pack_mutation_without_human_review"
      ]
    },
    {
      "id": "local.audio_judge.naturalness_preference",
      "kind": "audio_judge",
      "mode": "pairwise",
      "status": "optional",
      "cost_tier": "high",
      "privacy": "local_only",
      "signals": [
        "naturalness_preference",
        "pacing_preference"
      ],
      "inputs": {
        "required": [
          "audio_uri_a",
          "audio_uri_b"
        ],
        "optional": [
          "text",
          "comparison_rubric"
        ]
      },
      "runner": {
        "kind": "local_command",
        "command_template": [
          "python3",
          "${HEURISTIC_EVAL_AUDIO_RUNNERS}/pairwise_naturalness_runner.py",
          "--input",
          "${INPUT_JSON}",
          "--output",
          "${OUTPUT_JSONL}"
        ],
        "model_ref_env": "HEURISTIC_EVAL_PAIRWISE_AUDIO_JUDGE_MODEL"
      },
      "blocked_uses": [
        "absolute_quality_score",
        "version_promotion_without_regression_bank"
      ]
    },
    {
      "id": "local.human_review.voice_clone_spot_check",
      "kind": "human_review",
      "mode": "pointwise_or_pairwise",
      "status": "available",
      "cost_tier": "human",
      "privacy": "local_only",
      "signals": [
        "speaker_identity",
        "character_style",
        "pronunciation",
        "acceptable_variance"
      ],
      "inputs": {
        "required": [
          "review_task_json"
        ]
      },
      "runner": {
        "kind": "manual_or_local_ui",
        "entrypoint_hint": "Use eval_datasets/review_window/ task and result JSON."
      },
      "blocked_uses": []
    }
  ]
}
