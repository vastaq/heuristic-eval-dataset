{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "heuristic-eval review task",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "profile",
    "target_id",
    "audio_refs",
    "context",
    "choices"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "checkpoint_id": {
      "type": "string"
    },
    "return_to_run_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "audio_refs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "context": {
      "type": "object"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_mode": {
      "type": "string"
    },
    "auto_signal_visibility": {
      "type": "string"
    },
    "allowed_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tag_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "label_en": {
            "type": "string"
          },
          "label_zh": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "auto_observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "route_guess": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
