{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "heuristic-eval review result",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "task_id",
    "task_type",
    "reviewer_role",
    "decision",
    "confidence",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "review_id": {
      "type": "string"
    },
    "checkpoint_id": {
      "type": "string"
    },
    "return_to_run_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "reviewer_role": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_impression": {
      "type": "object"
    },
    "dimension_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ab_dimension_tags": {
      "type": "object",
      "properties": {
        "A": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "B": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "both": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "auto_signals_seen": {
      "type": "boolean"
    },
    "auto_signal_agreement": {
      "type": "string"
    },
    "final_decision": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
